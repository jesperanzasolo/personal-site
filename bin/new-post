#!/usr/bin/env bash
# Create a new draft post.
#   bin/new-post "How the memory platform consolidates at night"
# Creates content/posts/<slug>/index.md as a draft. Images and other files
# for the post go in the same folder and are referenced by filename.
set -euo pipefail

if [ $# -lt 1 ] || [ -z "$1" ]; then
  echo "usage: bin/new-post \"Post title\"" >&2
  exit 1
fi

title="$1"
root="$(cd "$(dirname "$0")/.." && pwd)"
slug="$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | sed -E "s/[’']//g; s/[^a-z0-9]+/-/g; s/^-+|-+$//g")"
dir="$root/content/posts/$slug"
file="$dir/index.md"

if [ -e "$file" ]; then
  echo "already exists: content/posts/$slug/index.md" >&2
  exit 1
fi

mkdir -p "$dir"
escaped_title="${title//\"/\\\"}"
cat > "$file" <<EOF
+++
title = "$escaped_title"
date = $(date +%F)
description = ""
draft = true
+++

EOF

echo "Created content/posts/$slug/index.md"
echo "Preview with bin/preview, publish with bin/publish $slug"
